@page "/prestamos"
@attribute [Authorize(Roles = "Admin, Bibliotecario")]
@using BBAPP.Data.Models
@using BBAPP.Services
@using BBAPP.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using System.Security.Claims // Necesario para ClaimTypes

@inject IPrestamoService PrestamoService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory // Para resolver UserManager en un ámbito seguro

<h3>Gestión de Préstamos</h3>

@* Mensajes de estado para el usuario *@
@if (!string.IsNullOrEmpty(mensajeEstado))
{
    <div class="alert @(mensajeEstado.Contains("Error") ? "alert-danger" : "alert-success")" role="alert">
        @mensajeEstado
    </div>
}

@if (cargando)
{
    <p><em>Cargando préstamos...</em></p>
}
else if (prestamos == null || !prestamos.Any())
{
    <p>No hay préstamos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Libro</th>
                <th>Usuario</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Vencimiento</th>
                <th>Fecha Devolución Real</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prestamo in prestamos)
            {
                <tr>
                    <td>@prestamo.TituloLibro</td>
                    <td>@prestamo.UsuarioNombreCompleto</td>
                    <td>@prestamo.FechaPrestamo.ToShortDateString()</td>
                    <td>@(prestamo.FechaVencimiento.ToShortDateString())</td>
                    <td>
                        @* Muestra la fecha de devolución si existe, si no, muestra el estado de la devolución/aprobación *@
                        @(prestamo.FechaDevolucion.HasValue ? prestamo.FechaDevolucion.Value.ToShortDateString() :
                            (prestamo.Estado == EstadoPrestamo.PendienteAprobacion ? "Pendiente de Aprobación" : "No Devuelto"))
                    </td>
                    <td>@prestamo.Estado.ToString()</td>
                    <td>
                        @* Botones para préstamos pendientes de aprobación (solo para Admin/Bibliotecario) *@
                        @if (prestamo.Estado == EstadoPrestamo.PendienteAprobacion && IsAdminOrBibliotecario)
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => AprobarSolicitud(prestamo.Id)">Aprobar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DenegarSolicitud(prestamo.Id)">Denegar</button>
                        }
                        @* Botón Devolver: Visible para préstamos Activos (solo para Admin/Bibliotecario en esta página) *@
                        @if (prestamo.Estado == EstadoPrestamo.Activo && IsAdminOrBibliotecario)
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => ProcesarDevolucion(prestamo.Id)">Devolver</button>
                        }
                        @* Botón Eliminar: Visible solo para Admin/Bibliotecario (para cualquier estado) *@
                        @if (IsAdminOrBibliotecario)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarPrestamo(prestamo.Id)">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<PrestamoDto> prestamos;
    private string CurrentUserId;
    private bool IsAdminOrBibliotecario = false;
    private bool cargando = true;
    private string mensajeEstado; // Para mostrar mensajes de éxito/error

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos();
    }

    private async Task CargarPrestamos()
    {
        cargando = true;
        mensajeEstado = string.Empty; // Limpiar mensajes anteriores
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            CurrentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            IsAdminOrBibliotecario = user.IsInRole("Admin") || user.IsInRole("Bibliotecario");

            // Si el usuario no es Admin ni Bibliotecario, esta página no debería ser accesible
            // El atributo [Authorize] ya maneja la redirección, pero es una doble verificación.
            if (!IsAdminOrBibliotecario)
            {
                NavigationManager.NavigateTo("/AccessDenied");
                return;
            }

            using (var scope = ScopeFactory.CreateScope())
            {
                var prestamoService = scope.ServiceProvider.GetRequiredService<IPrestamoService>();

                try
                {
                    // Admin y Bibliotecario ven TODOS los préstamos (activos, devueltos, pendientes, denegados, etc.)
                    prestamos = await prestamoService.GetTodosPrestamosAsync();
                }
                catch (Exception ex)
                {
                    mensajeEstado = $"Error al cargar préstamos: {ex.Message}";
                    Console.WriteLine($"Error al cargar préstamos: {ex.Message}");
                    prestamos = new List<PrestamoDto>();
                }
            }
        }
        else
        {
            // Si no está autenticado, no hay préstamos que mostrar y será redirigido por [Authorize]
            prestamos = new List<PrestamoDto>();
        }
        cargando = false;
    }

    private async Task ProcesarDevolucion(int prestamoId)
    {
        mensajeEstado = string.Empty;
        mensajeEstado = "Procesando devolución... por favor espere.";
        StateHasChanged();

        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var prestamoService = scope.ServiceProvider.GetRequiredService<IPrestamoService>();
                var prestamoActualizado = await prestamoService.ProcesarDevolucionAsync(prestamoId);

                if (prestamoActualizado != null)
                {
                    mensajeEstado = $"Libro '{prestamoActualizado.Libro?.Titulo}' devuelto exitosamente.";
                    await CargarPrestamos();
                }
                else
                {
                    mensajeEstado = "Error al procesar la devolución.";
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            mensajeEstado = $"Error al devolver libro: {ex.Message}";
            Console.WriteLine($"Error al devolver libro: {ex.Message}");
        }
        catch (Exception ex)
        {
            mensajeEstado = $"Ocurrió un error inesperado al procesar devolución: {ex.Message}";
            Console.WriteLine($"Ocurrió un error inesperado al procesar devolución: {ex.Message}");
        }
    }

    private async Task EliminarPrestamo(int prestamoId)
    {
        mensajeEstado = string.Empty;
        mensajeEstado = "Eliminando préstamo... por favor espere.";
        StateHasChanged();

        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var prestamoService = scope.ServiceProvider.GetRequiredService<IPrestamoService>();
                var exito = await prestamoService.EliminarPrestamoAsync(prestamoId);
                if (exito)
                {
                    mensajeEstado = "Préstamo eliminado exitosamente.";
                    await CargarPrestamos();
                }
                else
                {
                    mensajeEstado = "Error al eliminar préstamo.";
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            mensajeEstado = $"Error al eliminar préstamo: {ex.Message}";
            Console.WriteLine($"Error al eliminar préstamo: {ex.Message}");
        }
        catch (Exception ex)
        {
            mensajeEstado = $"Ocurrió un error inesperado al eliminar préstamo: {ex.Message}";
            Console.WriteLine($"Ocurrió un error inesperado al eliminar préstamo: {ex.Message}");
        }
    }

    // NUEVOS MÉTODOS para aprobar y denegar solicitudes de préstamo
    private async Task AprobarSolicitud(int prestamoId)
    {
        mensajeEstado = string.Empty;
        mensajeEstado = "Aprobando solicitud... por favor espere.";
        StateHasChanged();

        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var prestamoService = scope.ServiceProvider.GetRequiredService<IPrestamoService>();
                var prestamoAprobado = await prestamoService.AprobarPrestamoAsync(prestamoId);
                if (prestamoAprobado != null)
                {
                    mensajeEstado = $"Solicitud de préstamo para '{prestamoAprobado.Libro?.Titulo}' aprobada exitosamente.";
                    await CargarPrestamos(); // Recargar la lista para actualizar el estado
                }
                else
                {
                    mensajeEstado = "Error al aprobar la solicitud.";
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            mensajeEstado = $"Error al aprobar solicitud: {ex.Message}";
            Console.WriteLine($"Error al aprobar solicitud: {ex.Message}");
        }
        catch (Exception ex)
        {
            mensajeEstado = $"Ocurrió un error inesperado al aprobar la solicitud: {ex.Message}";
            Console.WriteLine($"Ocurrió un error inesperado al aprobar la solicitud: {ex.Message}");
        }
    }

    private async Task DenegarSolicitud(int prestamoId)
    {
        mensajeEstado = string.Empty;
        mensajeEstado = "Denegando solicitud... por favor espere.";
        StateHasChanged();

        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var prestamoService = scope.ServiceProvider.GetRequiredService<IPrestamoService>();
                var prestamoDenegado = await prestamoService.DenegarPrestamoAsync(prestamoId);
                if (prestamoDenegado != null)
                {
                    mensajeEstado = $"Solicitud de préstamo para '{prestamoDenegado.Libro?.Titulo}' denegada exitosamente.";
                    await CargarPrestamos(); // Recargar la lista para actualizar el estado
                }
                else
                {
                    mensajeEstado = "Error al denegar la solicitud.";
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            mensajeEstado = $"Error al denegar solicitud: {ex.Message}";
            Console.WriteLine($"Error al denegar solicitud: {ex.Message}");
        }
        catch (Exception ex)
        {
            mensajeEstado = $"Ocurrió un error inesperado al denegar la solicitud: {ex.Message}";
            Console.WriteLine($"Ocurrió un error inesperado al denegar la solicitud: {ex.Message}");
        }
    }
}
